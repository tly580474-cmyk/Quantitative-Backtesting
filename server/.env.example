# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quant_backtest

# Historical stock CSV root (contains 不复权/前复权/后复权)
STOCK_HISTORY_ROOT=D:\github_public_repo\所有股票的历史数据\每只股票一个文件

# AI Strategy Generation (Optional)
AI_STRATEGY_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 英文分号分隔；第一项为默认模型，所有前端模型选择器严格使用此列表
OPENAI_MODEL=model-1;model-2;model-3
OPENAI_TIMEOUT_MS=30000

# Market Data Sync (Phase 5, Optional)
MARKET_DATA_ENABLED=false
MARKET_DATA_PROVIDER=tencent
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=
INSTRUMENT_SYNC_ENABLED=true
INSTRUMENT_SYNC_TIME=15:20
MARKET_DATA_SYNC_TIME=15:30
# Automatic jobs skip weekends and exchange-calendar holidays; manual updates always run.
SCHEDULE_SKIP_NON_TRADING_PERIODS=true
# 个股日线仅在盘后定稿更新；盘中不会写入当天个股日线。
MARKET_DATA_INTRADAY_INTERVAL_MINUTES=30

# Full-market dragon-tiger list and market news collectors
DRAGON_TIGER_ENABLED=true
DRAGON_TIGER_SYNC_TIME=18:00
DRAGON_TIGER_RECHECK_TIME=18:30
MARKET_NEWS_ENABLED=true
MARKET_NEWS_REFRESH_INTERVAL_MINUTES=3
MARKET_NEWS_RETENTION_DAYS=3

# Market opinion agent scheduled email reports (Asia/Shanghai)
MARKET_OPINION_PUSH_ENABLED=false
# Optional dedicated model; empty falls back to the first OPENAI_MODEL entry.
MARKET_OPINION_MODEL=
MARKET_OPINION_MORNING_TIME=09:00
MARKET_OPINION_MIDDAY_TIME=12:00
MARKET_OPINION_CLOSE_TIME=16:00
MARKET_OPINION_PUSH_GRACE_MINUTES=20
MARKET_OPINION_PUSH_WEEKDAYS_ONLY=true
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Comma-separated recipients
MAIL_TO=

# Existing dataset-driven index updater
# Scans market_datasets and only updates existing index datasets.
MARKET_INDEX_AUTO_UPDATE_ENABLED=true
MARKET_CN_INDEX_UPDATE_TIME=20:00
MARKET_US_INDEX_UPDATE_TIME=05:00
FINANCIAL_DATA_ENABLED=true
FINANCIAL_DATA_UPDATE_TIME=19:00
FINANCIAL_DATA_LOOKBACK_DAYS=21
# Low-frequency market-health pipeline. Runs on natural days because macro releases
# are not tied to the exchange calendar; unchanged source data will not republish.
MARKET_HEALTH_ENABLED=true
MARKET_HEALTH_MACRO_CHECK_TIME=10:30
MARKET_HEALTH_PYTHON=python
RESEARCH_SNAPSHOT_MORNING_RETRY_TIME=08:30
RESEARCH_SNAPSHOT_UPDATE_TIME=18:00
RESEARCH_SNAPSHOT_RETRY_TIME=18:30
MINUTE_DATA_UPDATE_TIME=16:30
MINUTE_DATA_RETRY_TIME=17:30

# Phase 5.5 authoritative history path:
# legacy = old daily_candles only; prefer-v2 = v2 with legacy fallback; v2 = no fallback.
HISTORY_STORE_READ_MODE=prefer-v2
# Keep this true during the rollback window. Set false after v2 is formally accepted.
HISTORY_STORE_DUAL_WRITE=true

# Parquet + DuckDB research mirror
RESEARCH_SNAPSHOT_ROOT=./data/research-snapshots
# 每次自动或手动更新完成后，保留近 5×24 小时内的快照；当前有效快照始终受保护。
RESEARCH_SNAPSHOT_RETENTION_ENABLED=true
RESEARCH_SNAPSHOT_RETENTION_DAYS=5
BACKUP_ROOT=./data/backups
FACTOR_RESEARCH_ROOT=./data/factor-research
FACTOR_MINER_PYTHON=python
FACTOR_MINER_ROOT=../tools/factor-miner
FACTOR_MINER_TIMEOUT_MS=21600000
FACTOR_MINER_MAX_MEMORY_MB=4096
RESEARCH_QUERY_MAX_ROWS=10000
# Historical 1-minute Parquet lake. Relative paths are resolved from server/.
# 当前按 2010-2026 接入；ZIP 根目录仅供 minute:prepare 使用。
MINUTE_DATA_ZIP_ROOT=../../所有股票的历史数据/1m_price_zip
MINUTE_DATA_ROOT=../../所有股票的历史数据/1m_price_parquet
MINUTE_QUERY_MAX_ROWS=100000
# Tushare 历史分钟接口需单独开通权限；minute:update 会自动读取 server/.env。
TUSHARE_TOKEN=
TINYSHARE_TOKEN=
FUND_FLOW_UPDATE_TIME=16:20
FUND_FLOW_RETRY_TIME=17:20
MINUTE_UPDATE_WORKERS=4
MINUTE_UPDATE_REQUESTS_PER_MINUTE=180
# 通达信客户端根目录，需先在客户端完成 1 分钟盘后数据下载。
TDX_DATA_ROOT=D:/tdx
MINUTE_ONLINE_WORKERS=8
MINUTE_ONLINE_RETRIES=3
MINUTE_ONLINE_DATALEN=1023
MINUTE_ONLINE_MIN_COVERAGE=0.995
MINUTE_ONLINE_REQUESTS_PER_SECOND=6
MINUTE_ONLINE_THROTTLE_COOLDOWN_SECONDS=60
MINUTE_ONLINE_THROTTLE_MAX_COOLDOWN_SECONDS=300
MINUTE_ONLINE_RECOVERY_ROUNDS=2
MINUTE_ONLINE_RECOVERY_DELAY_SECONDS=30
# TDX TCP 影子源；连续 3 个交易日验收前不作为正式主源。
MINUTE_TDX_TCP_ENABLED=false
MINUTE_TDX_TCP_SHADOW_ENABLED=true
MINUTE_TDX_TCP_WORKERS=2
MINUTE_TDX_TCP_MIN_SERVERS=2
MINUTE_TDX_TCP_MAX_SERVERS=5
MINUTE_TDX_TCP_CONNECT_TIMEOUT_SECONDS=3
MINUTE_TDX_TCP_PAGE_SIZE=800
MINUTE_TDX_TCP_MAX_PAGES=30
MINUTE_TDX_TCP_MIN_COVERAGE=0.995
MINUTE_TDX_TCP_CHECKPOINT_ROOT=.logs/minute-data/checkpoints
MINUTE_UPDATE_LOCK_FILE=.logs/minute-data/update.lock
# 最终日线未就绪时，分钟湖任务保持“等待依赖”并自动重试的最长分钟数。
MINUTE_REFERENCE_WAIT_MINUTES=30
DUCKDB_TEMP_ROOT=
DUCKDB_MAX_CONCURRENT=2
DUCKDB_MAX_QUEUED=8
DUCKDB_MAX_TEMP_SIZE=50GB

# Independent operations admin console.
# Generate a long random token. Leaving this empty disables /api/admin/*.
ADMIN_API_TOKEN=

# Local agent harness. Claude remains the default and Codex is opt-in.
AGENT_ENABLED=false
AGENT_PROVIDER=claude
AGENT_CLAUDE_WORKING_DIRECTORY=
AGENT_CLAUDE_PATH=claude
AGENT_CLAUDE_GIT_BASH_PATH=C:/Program Files/Git/bin/bash.exe
AGENT_CODEX_ENABLED=false
AGENT_CODEX_PATH=codex
AGENT_CODEX_MODEL=
# Codex uses its own absolute Windows workspace and isolated state directory.
AGENT_CODEX_WORKING_DIRECTORY=D:/github_public_repo/量化回测
# Dedicated persistent Codex auth/thread directory.
AGENT_CODEX_HOME=C:/Users/<you>/AppData/Local/QuantBacktest/codex-home
# Project-specific OpenAI API key. Never reuse or copy the global Codex auth.json.
AGENT_CODEX_API_KEY=
AGENT_CODEX_MODEL_PROVIDER=
AGENT_CODEX_BASE_URL=
AGENT_CODEX_MODEL_CATALOG=
AGENT_CODEX_APPROVALS_ENABLED=false
AGENT_CODEX_APPROVAL_TIMEOUT_SECONDS=300
AGENT_CODEX_TOOLS_ENABLED=true
AGENT_CODEX_SANDBOX_MODE=workspace-write
# Windows 服务进程默认使用无需管理员初始化的受限令牌沙箱；如已完成 elevated setup 可改为 elevated。
AGENT_CODEX_WINDOWS_SANDBOX=unelevated
AGENT_CODEX_NETWORK_ENABLED=true
# 本地项目行情优先；外部 a-stock-data 仅用于本地缺失项，不为常规只读取数逐步审批。
AGENT_CODEX_MARKET_DATA_CLI=D:/github_public_repo/量化回测/server/scripts/agentMarketData.mjs
AGENT_CODEX_EXTERNAL_DATA_SKILL_ENABLED=false
AGENT_CODEX_PYTHON_PATH=C:/Users/<you>/AppData/Local/QuantBacktest/codex-home/a-stock-data-venv/Scripts/python.exe
AGENT_TIMEOUT_MINUTES=60
AGENT_CODEX_TIMEOUT_MINUTES=60
AGENT_MAX_CONCURRENT=1
AGENT_REPORT_ROOT=data/agent-reports
AGENT_ATTACHMENT_ROOT=tmp_output/.agent-attachments
AGENT_ATTACHMENT_MAX_FILE_MB=20
AGENT_ATTACHMENT_MAX_FILES=8
AGENT_ATTACHMENT_MAX_CONTEXT_CHARS=300000

PORT=3001
